+// ---- I/O, processes, links (used by lldb) ----------------------------------
+
+// XP: CancelIo, which cancels only the calling thread's I/O on the handle.
+// That is what the callers need where they cancel their own overlapped
+// operations; closing the handle cancels the rest.
+inline BOOL WINAPI CancelIoEx(HANDLE H, LPOVERLAPPED Ov) {
+  typedef BOOL(WINAPI * Fn)(HANDLE, LPOVERLAPPED);
+  static Fn Real = lookup<Fn>("kernel32.dll", "CancelIoEx");
+  if (Real)
+    return Real(H, Ov);
+  return ::CancelIo(H);
+}
+
+// Whether CancelIoEx can cancel another thread's I/O.
+inline bool HaveCancelIoEx() {
+  return lookup<FARPROC>("kernel32.dll", "CancelIoEx") != nullptr;
+}
+
+// XP: GetProcessImageFileNameW from psapi.dll, which the kernel answers
+// even before the process's loader has run, with the NT path mapped to a
+// DOS one unless PROCESS_NAME_NATIVE is asked for.  (GetModuleFileNameExW
+// fails until the loader has set up the module list, e.g. at the
+// create-process debug event.)
+inline BOOL WINAPI QueryFullProcessImageNameW(HANDLE Process, DWORD Flags,
+                                              LPWSTR Name, PDWORD Size) {
+  typedef BOOL(WINAPI * Fn)(HANDLE, DWORD, LPWSTR, PDWORD);
+  static Fn Real = lookup<Fn>("kernel32.dll", "QueryFullProcessImageNameW");
+  if (Real)
+    return Real(Process, Flags, Name, Size);
+  typedef DWORD(WINAPI * ImageFn)(HANDLE, LPWSTR, DWORD);
+  static ImageFn Image =
+      lookup<ImageFn>("psapi.dll", "GetProcessImageFileNameW");
+  wchar_t Nt[1024];
+  DWORD NtLen = Image ? Image(Process, Nt, 1024) : 0;
+  size_t N;
+  if (NtLen == 0 || NtLen >= 1024)
+    return FALSE;
+  if (Flags & 1 /* PROCESS_NAME_NATIVE */) {
+    if (NtLen >= *Size) {
+      ::SetLastError(ERROR_INSUFFICIENT_BUFFER);
+      return FALSE;
+    }
+    wmemcpy(Name, Nt, NtLen);
+    N = NtLen;
+  } else {
+    N = NtPathToDos(Nt, NtLen, Name, *Size);
+    if (N == 0)
+      return FALSE;
+  }
+  Name[N] = 0;
+  *Size = static_cast<DWORD>(N);
+  return TRUE;
+}
