+// ---- strings and registry --------------------------------------------------
+
+// XP: ordinal (code unit) comparison, upper-casing for ignore-case the way
+// the real function does.
+inline int WINAPI CompareStringOrdinal(LPCWCH A, int NA, LPCWCH B, int NB,
+                                       BOOL IgnoreCase) {
+  typedef int(WINAPI * Fn)(LPCWCH, int, LPCWCH, int, BOOL);
+  static Fn Real = lookup<Fn>("kernel32.dll", "CompareStringOrdinal");
+  if (Real)
+    return Real(A, NA, B, NB, IgnoreCase);
+  size_t LA = NA < 0 ? wcslen(A) : static_cast<size_t>(NA);
+  size_t LB = NB < 0 ? wcslen(B) : static_cast<size_t>(NB);
+  for (size_t I = 0; I < LA && I < LB; ++I) {
+    wchar_t CA = A[I], CB = B[I];
+    if (IgnoreCase) {
+      CA = towupper(CA);
+      CB = towupper(CB);
+    }
+    if (CA != CB)
+      return CA < CB ? CSTR_LESS_THAN : CSTR_GREATER_THAN;
+  }
+  return LA == LB ? CSTR_EQUAL : LA < LB ? CSTR_LESS_THAN : CSTR_GREATER_THAN;
+}
+
+// XP: RegOpenKeyExW + RegQueryValueExW, checking the type against the
+// RRF_RT_* flags.  No expansion of REG_EXPAND_SZ (callers here ask for the
+// raw data).
+inline LSTATUS WINAPI RegGetValueW(HKEY Key, LPCWSTR SubKey, LPCWSTR Value,
+                                   DWORD Flags, LPDWORD Type, PVOID Data,
+                                   LPDWORD Bytes) {
+  typedef LSTATUS(WINAPI * Fn)(HKEY, LPCWSTR, LPCWSTR, DWORD, LPDWORD, PVOID,
+                               LPDWORD);
+  static Fn Real = lookup<Fn>("advapi32.dll", "RegGetValueW");
+  if (Real)
+    return Real(Key, SubKey, Value, Flags, Type, Data, Bytes);
+  HKEY K = Key;
+  if (SubKey && *SubKey) {
+    LSTATUS R = ::RegOpenKeyExW(Key, SubKey, 0, KEY_QUERY_VALUE, &K);
+    if (R != ERROR_SUCCESS)
+      return R;
+  }
+  DWORD T = 0;
+  LSTATUS R = ::RegQueryValueExW(K, Value, nullptr, &T,
+                                 static_cast<LPBYTE>(Data), Bytes);
+  if (K != Key)
+    ::RegCloseKey(K);
+  if (R != ERROR_SUCCESS)
+    return R;
+  if (T <= 11 && !(Flags & (1u << T)) && (Flags & 0xffff) != 0xffff)
+    return ERROR_UNSUPPORTED_TYPE;
+  if (Type)
+    *Type = T;
+  return ERROR_SUCCESS;
+}
+
+// ---- threads, processors and memory ----------------------------------------
+
+// XP: the thread id from NtQueryInformationThread (ThreadBasicInformation).
+inline DWORD WINAPI GetThreadId(HANDLE Thread) {
+  typedef DWORD(WINAPI * Fn)(HANDLE);
+  static Fn Real = lookup<Fn>("kernel32.dll", "GetThreadId");
+  if (Real)
+    return Real(Thread);
+  if (Thread == ::GetCurrentThread())
+    return ::GetCurrentThreadId();
+  static auto NtQuery = lookup<NtQueryInformationThreadFn>(
+      "ntdll.dll", "NtQueryInformationThread");
+  XP_THREAD_BASIC_INFORMATION Info{};
+  if (!NtQuery)
+    return 0;
+  XP_NTSTATUS St = NtQuery(Thread, 0, &Info, sizeof(Info), nullptr);
+  if (St < 0) {
+    failNt(St);
+    return 0;
+  }
+  return static_cast<DWORD>(reinterpret_cast<ULONG_PTR>(Info.UniqueThread));
+}
+
+// XP: no large pages.
+inline SIZE_T WINAPI GetLargePageMinimum() {
+  typedef SIZE_T(WINAPI * Fn)();
+  static Fn Real = lookup<Fn>("kernel32.dll", "GetLargePageMinimum");
+  return Real ? Real() : 0;
+}
