+#define CreateSymbolicLinkW llvm::xpcompat::CreateSymbolicLinkW
+#define Wow64GetThreadContext llvm::xpcompat::Wow64GetThreadContext
+#define Wow64SetThreadContext llvm::xpcompat::Wow64SetThreadContext
+#define InitializeProcThreadAttributeList                                     \
+  llvm::xpcompat::InitializeProcThreadAttributeList
+#define UpdateProcThreadAttribute llvm::xpcompat::UpdateProcThreadAttribute
+#define DeleteProcThreadAttributeList                                         \
+  llvm::xpcompat::DeleteProcThreadAttributeList
+// (not CreateProcess: lldb has methods of that name and undefines it)
+#define CreateProcessW llvm::xpcompat::CreateProcessW
+#define LoadLibraryExA llvm::xpcompat::LoadLibraryExA
+#undef RegGetValue
+#define RegGetValue llvm::xpcompat::RegGetValueW
+#define RegGetValueW llvm::xpcompat::RegGetValueW
+#define SetFileInformationByHandle llvm::xpcompat::SetFileInformationByHandle
+#define GetFinalPathNameByHandleW llvm::xpcompat::GetFinalPathNameByHandleW
+#define CompareStringOrdinal llvm::xpcompat::CompareStringOrdinal
+// lldb has methods named GetThreadId; it calls llvm::xpcompat::GetThreadId
+#ifndef LLVM_XPCOMPAT_NO_GETTHREADID_MACRO
+#define GetThreadId llvm::xpcompat::GetThreadId
+#endif
+#define GetLargePageMinimum llvm::xpcompat::GetLargePageMinimum
+#ifdef LLVM_XPCOMPAT_PROCESSOR_GROUPS
+#define GetLogicalProcessorInformationEx                                      \
+  llvm::xpcompat::GetLogicalProcessorInformationEx
+#define GetProcessGroupAffinity llvm::xpcompat::GetProcessGroupAffinity
+#define GetThreadGroupAffinity llvm::xpcompat::GetThreadGroupAffinity
+#define SetThreadGroupAffinity llvm::xpcompat::SetThreadGroupAffinity
+#endif
+
+#endif
+
+// Outside the include guard: wherever lldb includes this, its GetThreadId
