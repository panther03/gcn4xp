+//===----------------------------------------------------------------------===//
+//
+// Lets LLVM run on Windows XP.  Each function below stands in for a Windows
+// API of the same name.  For Vista and Windows 7 APIs it calls the real
+// function when the system has it (looked up at run time, so the executable
+// does not import it) and otherwise does the same job with what XP provides,
+// or fails the way the callers already expect from older systems and Wine.
+// For older APIs that LLVM calls with flags XP does not know, it retries
+// without them.
+//
+// Included from WindowsSupport.h; the #defines at the end redirect
+// everything after it to these versions.  The shell functions are in
+// XPCompatShell.h, for files that include <shlobj.h>.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_SUPPORT_WINDOWS_XPCOMPAT_H
+#define LLVM_SUPPORT_WINDOWS_XPCOMPAT_H
+
+#include <errno.h>
+#include <io.h>
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+#include <wctype.h>
+
+namespace llvm {
+namespace xpcompat {
+
+template <typename F> inline F lookup(const char *Dll, const char *Name) {
+  HMODULE M = ::GetModuleHandleA(Dll);
+  if (!M)
+    M = ::LoadLibraryA(Dll);
+  return M ? reinterpret_cast<F>(
+                 reinterpret_cast<void *>(::GetProcAddress(M, Name)))
+           : nullptr;
+}
+
+// ---- ntdll pieces present since NT 4 ---------------------------------------
+
+typedef LONG XP_NTSTATUS;
+struct XP_IO_STATUS_BLOCK {
+  union {
+    XP_NTSTATUS Status;
+    PVOID Pointer;
+  };
+  ULONG_PTR Information;
+};
+struct XP_UNICODE_STRING {
+  USHORT Length;
+  USHORT MaximumLength;
+  PWSTR Buffer;
+};
+struct XP_THREAD_BASIC_INFORMATION {
+  XP_NTSTATUS ExitStatus;
+  PVOID TebBaseAddress;
+  HANDLE UniqueProcess; // CLIENT_ID
+  HANDLE UniqueThread;
+  ULONG_PTR AffinityMask;
+  LONG Priority;
+  LONG BasePriority;
+};
+typedef XP_NTSTATUS(NTAPI *NtSetInformationFileFn)(HANDLE,
+                                                   XP_IO_STATUS_BLOCK *,
+                                                   PVOID, ULONG, int);
+typedef XP_NTSTATUS(NTAPI *NtQueryObjectFn)(HANDLE, int, PVOID, ULONG,
+                                            PULONG);
+typedef XP_NTSTATUS(NTAPI *NtQueryInformationThreadFn)(HANDLE, int, PVOID,
+                                                       ULONG, PULONG);
+typedef ULONG(NTAPI *RtlNtStatusToDosErrorFn)(XP_NTSTATUS);
+
+inline BOOL failNt(XP_NTSTATUS St) {
+  static auto ToDos = lookup<RtlNtStatusToDosErrorFn>(
+      "ntdll.dll", "RtlNtStatusToDosError");
+  ::SetLastError(ToDos ? ToDos(St) : ERROR_GEN_FAILURE);
+  return FALSE;
+}
+
+// ---- files -----------------------------------------------------------------
+
+// XP: deletion on close through NtSetInformationFile, which is what Vista's
+// kernel32 does too.  Renames report "not implemented"; the callers then fall
+// back to MoveFileExW, as they do on Wine.
+inline BOOL WINAPI SetFileInformationByHandle(HANDLE H,
+                                              FILE_INFO_BY_HANDLE_CLASS Class,
+                                              LPVOID Info, DWORD Size) {
+  typedef BOOL(WINAPI * Fn)(HANDLE, FILE_INFO_BY_HANDLE_CLASS, LPVOID, DWORD);
+  static Fn Real = lookup<Fn>("kernel32.dll", "SetFileInformationByHandle");
+  if (Real)
+    return Real(H, Class, Info, Size);
+  if (Class == FileDispositionInfo && Size >= sizeof(BOOLEAN)) {
+    static auto NtSet = lookup<NtSetInformationFileFn>("ntdll.dll",
+                                                       "NtSetInformationFile");
+    if (!NtSet) {
+      ::SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+      return FALSE;
+    }
+    XP_IO_STATUS_BLOCK Io{};
+    BOOLEAN Delete = static_cast<FILE_DISPOSITION_INFO *>(Info)->DeleteFile;
+    XP_NTSTATUS St = NtSet(H, &Io, &Delete, sizeof(Delete),
+                           13 /* FileDispositionInformation */);
+    return St >= 0 ? TRUE : failNt(St);
+  }
+  ::SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+  return FALSE;
+}
+
+// An NT path (\Device\HarddiskVolume1\dir\file) as a DOS one (C:\dir\file):
+// the drive letter whose device is the path's prefix.  Returns the length
+// written (no terminator), or 0 when no drive matches or it does not fit.
+inline size_t NtPathToDos(const wchar_t *Nt, size_t NtLen, wchar_t *Out,
+                          size_t Count) {
+  wchar_t Drive[3] = L"A:";
+  for (wchar_t D = L'A'; D <= L'Z'; ++D) {
+    wchar_t Target[1024];
+    Drive[0] = D;
+    if (!::QueryDosDeviceW(Drive, Target, 1024))
+      continue;
+    size_t TL = wcslen(Target);
+    if (TL && TL < NtLen && wcsncmp(Nt, Target, TL) == 0 &&
+        Nt[TL] == L'\\') {
+      if (2 + NtLen - TL >= Count) {
+        ::SetLastError(ERROR_FILENAME_EXCED_RANGE);
+        return 0;
+      }
+      Out[0] = D;
+      Out[1] = L':';
+      wmemcpy(Out + 2, Nt + TL, NtLen - TL);
+      return 2 + NtLen - TL;
+    }
+  }
+  ::SetLastError(ERROR_PATH_NOT_FOUND);
+  return 0;
+}
+
+// XP: the handle's NT name (\Device\HarddiskVolume1\dir\file) from
+// NtQueryObject, with the device mapped back to its drive letter for
+// VOLUME_NAME_DOS.  Only disk files: NtQueryObject can block on pipes.
+inline DWORD WINAPI GetFinalPathNameByHandleW(HANDLE H, LPWSTR Out,
+                                              DWORD Count, DWORD Flags) {
+  typedef DWORD(WINAPI * Fn)(HANDLE, LPWSTR, DWORD, DWORD);
+  static Fn Real = lookup<Fn>("kernel32.dll", "GetFinalPathNameByHandleW");
+  if (Real)
+    return Real(H, Out, Count, Flags);
+  static auto NtQuery = lookup<NtQueryObjectFn>("ntdll.dll", "NtQueryObject");
+  if (!NtQuery || ::GetFileType(H) != FILE_TYPE_DISK) {
+    ::SetLastError(ERROR_NOT_SUPPORTED);
+    return 0;
+  }
+  union {
+    XP_UNICODE_STRING Name;
+    wchar_t Space[4096];
+  } Buf;
+  ULONG Len = 0;
+  XP_NTSTATUS St = NtQuery(H, 1 /* ObjectNameInformation */, &Buf,
+                           sizeof(Buf) - sizeof(wchar_t), &Len);
+  if (St < 0) {
+    failNt(St);
+    return 0;
+  }
+  const wchar_t *Nt = Buf.Name.Buffer;
+  size_t NtLen = Buf.Name.Length / sizeof(wchar_t);
+  wchar_t Result[4096 + 8];
+  size_t N = 0;
+
+  if ((Flags & 0xf) == 0x2 /* VOLUME_NAME_NT */) {
+    if (NtLen >= 4096) {
+      ::SetLastError(ERROR_FILENAME_EXCED_RANGE);
+      return 0;
+    }
+    wmemcpy(Result, Nt, NtLen);
+    N = NtLen;
+  } else {
+    wmemcpy(Result, L"\\\\?\\", 4);
+    N = NtPathToDos(Nt, NtLen, Result + 4, 4096);
+    if (N == 0)
+      return 0;
+    N += 4;
+  }
+  // like the real one: the length without the terminator when it fits,
+  // else the size needed including it
+  if (N + 1 > Count)
+    return static_cast<DWORD>(N + 1);
+  wmemcpy(Out, Result, N);
+  Out[N] = 0;
+  return static_cast<DWORD>(N);
+}
+
+// ---- old functions, newer flags --------------------------------------------
+// These exist on XP, but XP rejects flag values added later with
+// ERROR_INVALID_PARAMETER.  Retry with what XP understands.
+
+#if _WIN32_WINNT >= 0x0601
+// FindExInfoBasic and FIND_FIRST_EX_LARGE_FETCH are Windows 7 additions;
+// both are only optimisations.
+#define LLVM_XPCOMPAT_FINDFIRSTFILEEX
+inline HANDLE WINAPI FindFirstFileExW(LPCWSTR Name, FINDEX_INFO_LEVELS Level,
+                                      LPVOID Data, FINDEX_SEARCH_OPS Op,
+                                      LPVOID Filter, DWORD Flags) {
+  HANDLE H = ::FindFirstFileExW(Name, Level, Data, Op, Filter, Flags);
+  if (H == INVALID_HANDLE_VALUE &&
+      ::GetLastError() == ERROR_INVALID_PARAMETER &&
+      (Level == FindExInfoBasic || (Flags & FIND_FIRST_EX_LARGE_FETCH)))
+    H = ::FindFirstFileExW(Name, FindExInfoStandard, Data, Op, Filter,
+                           Flags & ~FIND_FIRST_EX_LARGE_FETCH);
+  return H;
+}
+#endif
+
+// The LOAD_LIBRARY_SEARCH_* flags need Windows 7 (or KB2533623).  Without
+// them, load from the system directory by full path, which is what
+// LOAD_LIBRARY_SEARCH_SYSTEM32 asks for anyway.
+inline HMODULE WINAPI LoadLibraryExA(LPCSTR Name, HANDLE File, DWORD Flags) {
+  const DWORD SearchFlags = 0x0000ff00; // LOAD_LIBRARY_SEARCH_*
+  HMODULE M = ::LoadLibraryExA(Name, File, Flags);
+  if (M || !(Flags & SearchFlags) ||
+      ::GetLastError() != ERROR_INVALID_PARAMETER)
+    return M;
+  char Path[MAX_PATH];
+  UINT N = ::GetSystemDirectoryA(Path, MAX_PATH);
+  if ((Flags & 0x00000800 /* LOAD_LIBRARY_SEARCH_SYSTEM32 */) && N &&
+      N + 1 + strlen(Name) < MAX_PATH && !strchr(Name, '\\')) {
+    Path[N] = '\\';
+    strcpy(Path + N + 1, Name);
+    return ::LoadLibraryExA(Path, File, Flags & ~SearchFlags);
+  }
+  return ::LoadLibraryExA(Name, File, Flags & ~SearchFlags);
+}
