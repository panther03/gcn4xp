+// Process attribute lists (Vista): XP has none.  The list calls succeed
+// without doing anything, and CreateProcessW below drops the extended
+// start-up information; the child then inherits every inheritable handle,
+// as all children did before Vista.
+inline bool HaveAttributeLists() {
+  return lookup<FARPROC>("kernel32.dll",
+                         "InitializeProcThreadAttributeList") != nullptr;
+}
+
+inline BOOL WINAPI InitializeProcThreadAttributeList(
+    LPPROC_THREAD_ATTRIBUTE_LIST List, DWORD Count, DWORD Flags,
+    PSIZE_T Size) {
+  typedef BOOL(WINAPI * Fn)(LPPROC_THREAD_ATTRIBUTE_LIST, DWORD, DWORD,
+                            PSIZE_T);
+  static Fn Real =
+      lookup<Fn>("kernel32.dll", "InitializeProcThreadAttributeList");
+  if (Real)
+    return Real(List, Count, Flags, Size);
+  const SIZE_T Need = 64;
+  if (!List || *Size < Need) {
+    *Size = Need;
+    ::SetLastError(ERROR_INSUFFICIENT_BUFFER);
+    return FALSE;
+  }
+  ZeroMemory(List, Need);
+  return TRUE;
+}
+
+inline BOOL WINAPI UpdateProcThreadAttribute(
+    LPPROC_THREAD_ATTRIBUTE_LIST List, DWORD Flags, DWORD_PTR Attribute,
+    PVOID Value, SIZE_T Size, PVOID Previous, PSIZE_T ReturnSize) {
+  typedef BOOL(WINAPI * Fn)(LPPROC_THREAD_ATTRIBUTE_LIST, DWORD, DWORD_PTR,
+                            PVOID, SIZE_T, PVOID, PSIZE_T);
+  static Fn Real = lookup<Fn>("kernel32.dll", "UpdateProcThreadAttribute");
+  if (Real)
+    return Real(List, Flags, Attribute, Value, Size, Previous, ReturnSize);
+  return TRUE;
+}
+
+inline VOID WINAPI DeleteProcThreadAttributeList(
+    LPPROC_THREAD_ATTRIBUTE_LIST List) {
+  typedef VOID(WINAPI * Fn)(LPPROC_THREAD_ATTRIBUTE_LIST);
+  static Fn Real =
+      lookup<Fn>("kernel32.dll", "DeleteProcThreadAttributeList");
+  if (Real)
+    Real(List);
+}
+
+inline BOOL WINAPI CreateProcessW(LPCWSTR App, LPWSTR Cmd,
+                                  LPSECURITY_ATTRIBUTES ProcAttr,
+                                  LPSECURITY_ATTRIBUTES ThreadAttr,
+                                  BOOL Inherit, DWORD Flags, LPVOID Env,
+                                  LPCWSTR Dir, LPSTARTUPINFOW Startup,
+                                  LPPROCESS_INFORMATION Info) {
+  if ((Flags & EXTENDED_STARTUPINFO_PRESENT) && !HaveAttributeLists()) {
+    STARTUPINFOW Plain = *Startup;
+    Plain.cb = sizeof(Plain);
+    return ::CreateProcessW(App, Cmd, ProcAttr, ThreadAttr, Inherit,
+                            Flags & ~EXTENDED_STARTUPINFO_PRESENT, Env, Dir,
+                            &Plain, Info);
+  }
+  return ::CreateProcessW(App, Cmd, ProcAttr, ThreadAttr, Inherit, Flags, Env,
+                          Dir, Startup, Info);
+}
+
+// XP: setting the mode returns the old one; put it back.
+inline UINT WINAPI GetErrorMode() {
+  typedef UINT(WINAPI * Fn)();
+  static Fn Real = lookup<Fn>("kernel32.dll", "GetErrorMode");
+  if (Real)
+    return Real();
+  UINT Mode = ::SetErrorMode(0);
+  ::SetErrorMode(Mode);
+  return Mode;
+}
+
+// ---- C runtime: XP's msvcrt.dll has no "secure" _s variants ----------------
+
+inline errno_t _wfopen_s(FILE **File, const wchar_t *Name,
+                         const wchar_t *Mode) {
+  typedef errno_t(__cdecl * Fn)(FILE **, const wchar_t *, const wchar_t *);
+  static Fn Real = lookup<Fn>("msvcrt.dll", "_wfopen_s");
+  if (Real)
+    return Real(File, Name, Mode);
+  *File = ::_wfopen(Name, Mode);
+  return *File ? 0 : errno;
+}
+
+inline errno_t _wsopen_s(int *Fd, const wchar_t *Name, int OFlag, int ShFlag,
+                         int PMode) {
+  typedef errno_t(__cdecl * Fn)(int *, const wchar_t *, int, int, int);
+  static Fn Real = lookup<Fn>("msvcrt.dll", "_wsopen_s");
+  if (Real)
+    return Real(Fd, Name, OFlag, ShFlag, PMode);
+  *Fd = ::_wsopen(Name, OFlag, ShFlag, PMode);
+  return *Fd == -1 ? errno : 0;
+}
+
+} // namespace xpcompat
+} // namespace llvm
+
+#define GetErrorMode llvm::xpcompat::GetErrorMode
+#define _wfopen_s llvm::xpcompat::_wfopen_s
+#define _wsopen_s llvm::xpcompat::_wsopen_s
+#ifdef LLVM_XPCOMPAT_FINDFIRSTFILEEX
+#undef FindFirstFileEx
+#define FindFirstFileEx llvm::xpcompat::FindFirstFileExW
+#define FindFirstFileExW llvm::xpcompat::FindFirstFileExW
+#endif
+#define CancelIoEx llvm::xpcompat::CancelIoEx
