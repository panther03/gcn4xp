+//===- llvm/Support/Windows/XPCompatShell.h - Windows XP fallbacks -*- C++ -*-//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The shell API part of XPCompat.h, for files that include <shlobj.h>
+// (which cannot go into WindowsSupport.h: its COM headers clash with LLVM
+// names).  Include after <shlobj.h>.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_SUPPORT_WINDOWS_XPCOMPATSHELL_H
+#define LLVM_SUPPORT_WINDOWS_XPCOMPATSHELL_H
+
+#include "llvm/Support/Windows/XPCompat.h"
+#include <shlobj.h>
+
+namespace llvm {
+namespace xpcompat {
+
+// XP: the CSIDL equivalents through SHGetFolderPathW.
+inline HRESULT WINAPI SHGetKnownFolderPath(REFKNOWNFOLDERID Id, DWORD Flags,
+                                           HANDLE Token, PWSTR *Path) {
+  typedef HRESULT(WINAPI * Fn)(REFKNOWNFOLDERID, DWORD, HANDLE, PWSTR *);
+  static Fn Real = lookup<Fn>("shell32.dll", "SHGetKnownFolderPath");
+  if (Real)
+    return Real(Id, Flags, Token, Path);
+  int Csidl;
+  if (IsEqualGUID(Id, FOLDERID_Profile))
+    Csidl = CSIDL_PROFILE;
+  else if (IsEqualGUID(Id, FOLDERID_LocalAppData))
+    Csidl = CSIDL_LOCAL_APPDATA;
+  else if (IsEqualGUID(Id, FOLDERID_RoamingAppData))
+    Csidl = CSIDL_APPDATA;
+  else
+    return E_INVALIDARG;
+  if (Flags & KF_FLAG_CREATE)
+    Csidl |= CSIDL_FLAG_CREATE;
+  wchar_t Buf[MAX_PATH];
+  HRESULT R = ::SHGetFolderPathW(nullptr, Csidl, Token, 0, Buf);
+  if (R != S_OK)
+    return R;
+  size_t Bytes = (wcslen(Buf) + 1) * sizeof(wchar_t);
+  *Path = static_cast<PWSTR>(::CoTaskMemAlloc(Bytes));
+  if (!*Path)
+    return E_OUTOFMEMORY;
+  memcpy(*Path, Buf, Bytes);
+  return S_OK;
+}
+
+// XP has no IFileOperation either, so moving files to the recycle bin fails
+// before this is reached; this keeps the import out of the executable.
+inline HRESULT WINAPI SHCreateItemFromIDList(PCIDLIST_ABSOLUTE Pidl,
+                                             REFIID Iid, void **Out) {
+  typedef HRESULT(WINAPI * Fn)(PCIDLIST_ABSOLUTE, REFIID, void **);
+  static Fn Real = lookup<Fn>("shell32.dll", "SHCreateItemFromIDList");
+  if (Real)
+    return Real(Pidl, Iid, Out);
+  *Out = nullptr;
+  return E_NOTIMPL;
+}
+
+} // namespace xpcompat
+} // namespace llvm
+
+#define SHGetKnownFolderPath llvm::xpcompat::SHGetKnownFolderPath
+#define SHCreateItemFromIDList llvm::xpcompat::SHCreateItemFromIDList
+
+#endif
