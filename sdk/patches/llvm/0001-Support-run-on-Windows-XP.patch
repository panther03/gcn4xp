+#if _WIN32_WINNT >= 0x0601
+// XP has one processor group: report "not implemented" for the topology
+// queries, which the callers treat like a system without the feature, and
+// map group affinities onto the plain affinity masks.
+#define LLVM_XPCOMPAT_PROCESSOR_GROUPS
+inline BOOL WINAPI GetLogicalProcessorInformationEx(
+    LOGICAL_PROCESSOR_RELATIONSHIP Rel,
+    PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX Buf, PDWORD Len) {
+  typedef BOOL(WINAPI * Fn)(LOGICAL_PROCESSOR_RELATIONSHIP,
+                            PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX, PDWORD);
+  static Fn Real =
+      lookup<Fn>("kernel32.dll", "GetLogicalProcessorInformationEx");
+  if (Real)
+    return Real(Rel, Buf, Len);
+  ::SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+  return FALSE;
+}
+
+inline BOOL WINAPI GetProcessGroupAffinity(HANDLE Process, PUSHORT Count,
+                                           PUSHORT Groups) {
+  typedef BOOL(WINAPI * Fn)(HANDLE, PUSHORT, PUSHORT);
+  static Fn Real = lookup<Fn>("kernel32.dll", "GetProcessGroupAffinity");
+  if (Real)
+    return Real(Process, Count, Groups);
+  ::SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+  return FALSE;
+}
+
+inline BOOL WINAPI GetThreadGroupAffinity(HANDLE Thread,
+                                          PGROUP_AFFINITY Affinity) {
+  typedef BOOL(WINAPI * Fn)(HANDLE, PGROUP_AFFINITY);
+  static Fn Real = lookup<Fn>("kernel32.dll", "GetThreadGroupAffinity");
+  if (Real)
+    return Real(Thread, Affinity);
+  DWORD_PTR ProcessMask = 0, SystemMask = 0;
+  if (!::GetProcessAffinityMask(::GetCurrentProcess(), &ProcessMask,
+                                &SystemMask))
+    return FALSE;
+  ZeroMemory(Affinity, sizeof(*Affinity));
+  Affinity->Mask = ProcessMask;
+  return TRUE;
+}
+
+inline BOOL WINAPI SetThreadGroupAffinity(HANDLE Thread,
+                                          const GROUP_AFFINITY *Affinity,
+                                          PGROUP_AFFINITY Previous) {
+  typedef BOOL(WINAPI * Fn)(HANDLE, const GROUP_AFFINITY *, PGROUP_AFFINITY);
+  static Fn Real = lookup<Fn>("kernel32.dll", "SetThreadGroupAffinity");
+  if (Real)
+    return Real(Thread, Affinity, Previous);
+  if (Affinity->Group != 0) {
+    ::SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+  }
+  DWORD_PTR Old = ::SetThreadAffinityMask(Thread, Affinity->Mask);
+  if (!Old)
+    return FALSE;
+  if (Previous) {
+    ZeroMemory(Previous, sizeof(*Previous));
+    Previous->Mask = Old;
+  }
+  return TRUE;
+}
+#endif
