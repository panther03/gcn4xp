diff -Nru a/lldb/source/Host/windows/ProcessRunLock.cpp b/lldb/source/Host/windows/ProcessRunLock.cpp
--- a/lldb/source/Host/windows/ProcessRunLock.cpp	2026-11-17 13:31:39.384931500 -0600
+++ b/lldb/source/Host/windows/ProcessRunLock.cpp	2026-11-17 13:31:39.276241300 -0600
@@ -9,38 +9,41 @@
 #include "lldb/Host/ProcessRunLock.h"
 #include "lldb/Host/windows/windows.h"
 
-static PSRWLOCK GetLock(lldb::rwlock_t lock) {
-  return static_cast<PSRWLOCK>(lock);
+// A std::shared_mutex rather than an SRWLOCK, which needs Windows Vista; with
+// libstdc++ on MinGW it is a winpthreads rwlock, which works on Windows XP.
+#include <shared_mutex>
+
+static std::shared_mutex *GetLock(lldb::rwlock_t lock) {
+  return static_cast<std::shared_mutex *>(lock);
 }
 
 static bool ReadLock(lldb::rwlock_t rwlock) {
-  ::AcquireSRWLockShared(GetLock(rwlock));
+  GetLock(rwlock)->lock_shared();
   return true;
 }
 
 static bool ReadUnlock(lldb::rwlock_t rwlock) {
-  ::ReleaseSRWLockShared(GetLock(rwlock));
+  GetLock(rwlock)->unlock_shared();
   return true;
 }
 
 static bool WriteLock(lldb::rwlock_t rwlock) {
-  ::AcquireSRWLockExclusive(GetLock(rwlock));
+  GetLock(rwlock)->lock();
   return true;
 }
 
 static bool WriteUnlock(lldb::rwlock_t rwlock) {
-  ::ReleaseSRWLockExclusive(GetLock(rwlock));
+  GetLock(rwlock)->unlock();
   return true;
 }
 
 using namespace lldb_private;
 
 ProcessRunLock::ProcessRunLock() : m_running(false) {
-  m_rwlock = new SRWLOCK;
-  InitializeSRWLock(GetLock(m_rwlock));
+  m_rwlock = new std::shared_mutex;
 }
 
-ProcessRunLock::~ProcessRunLock() { delete static_cast<SRWLOCK *>(m_rwlock); }
+ProcessRunLock::~ProcessRunLock() { delete GetLock(m_rwlock); }
 
 bool ProcessRunLock::ReadTryLock() {
   ::ReadLock(m_rwlock);
diff -Nru a/lldb/source/Plugins/Process/Windows/Common/ProcessWindows.cpp b/lldb/source/Plugins/Process/Windows/Common/ProcessWindows.cpp
--- a/lldb/source/Plugins/Process/Windows/Common/ProcessWindows.cpp	2026-11-17 13:31:39.825884000 -0600
+++ b/lldb/source/Plugins/Process/Windows/Common/ProcessWindows.cpp	2026-11-17 13:31:39.709159500 -0600
@@ -57,6 +57,15 @@
     copied = ::GetModuleFileNameExW(process_handle, NULL, file_name.data(),
                                     file_name_size);
   } while (copied >= file_name_size);
+  if (copied == 0) {
+    // Windows XP cannot name the main module before the process's loader
+    // has run, which is the case at the create-process debug event; the
+    // image name comes from the kernel instead.
+    DWORD size = file_name_size;
+    if (::QueryFullProcessImageNameW(process_handle, 0, file_name.data(),
+                                     &size))
+      copied = size;
+  }
   file_name.resize(copied);
   std::string result;
   llvm::convertWideToUTF8(file_name.data(), result);
