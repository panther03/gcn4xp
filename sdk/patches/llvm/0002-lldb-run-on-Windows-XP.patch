@@ -25,9 +25,23 @@
 #include <winerror.h>
 #include <winsock2.h>
 
+#if defined(__MINGW32__) && !defined(_LIBCPP_VERSION)
+#include <pthread.h>
+#endif
+
 using namespace lldb;
 using namespace lldb_private;
 
+// The Windows handle of a std::thread.  With libstdc++ on MinGW the native
+// handle is a winpthreads pthread_t, not a HANDLE.
+static HANDLE ThreadHandle(std::thread &t) {
+#if defined(__MINGW32__) && !defined(_LIBCPP_VERSION)
+  return pthread_gethandle(t.native_handle());
+#else
+  return t.native_handle();
+#endif
+}
